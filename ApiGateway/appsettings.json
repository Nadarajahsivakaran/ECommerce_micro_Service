{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "Warning",
			"Microsoft.Hosting.Lifetime": "Information"
		}
	},

	"Jwt": {
		"Key": "ThisIsASuperSecretKeyForJwtAuth123!",
		"Issuer": "AuthService",
		"Audience": "AuthServiceUsers",
		"ExpireMinutes": 60
	},

	"AllowedHosts": "*",

	"ReverseProxy": {
		"Routes": {
			"product-route": {
				"ClusterId": "product-cluster",
				"Match": { "Path": "/api/product/{**catch-all}" }
			},
			"category-route": {
				"ClusterId": "product-cluster",
				"Match": { "Path": "/api/Categories/{**catch-all}" }
			},
			"auth-route": {
				"ClusterId": "auth-cluster",
				"Match": { "Path": "/api/auth/{**catch-all}" }
			},


			"product-swagger": {
				"ClusterId": "product-cluster",
				"Match": { "Path": "/swagger/product/{**catch-all}" },

				"Transforms": [
					{ "PathRemovePrefix": "/swagger/product" },
					{ "PathPrefix": "/swagger" }
				]
			},
			"auth-swagger": {
				"ClusterId": "auth-cluster",
				"Match": { "Path": "/swagger/auth/{**catch-all}" },

				"Transforms": [
					{ "PathRemovePrefix": "/swagger/auth" },
					{ "PathPrefix": "/swagger" }
				]
			}

		},
		"Clusters": {
			"product-cluster": {
				"Destinations": {
					"product-api": { "Address": "https://localhost:5002/" }
				}
			},
			"auth-cluster": {
				"Destinations": {
					"auth-api": { "Address": "https://localhost:5001/" }
				}
			}
		}
	}

}
