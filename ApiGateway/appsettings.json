{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},

	"Jwt": {
		"Key": "ThisIsASuperSecretKeyForJwtAuth123!",
		"Issuer": "AuthService",
		"Audience": "AuthServiceUsers",
		"ExpireMinutes": 60
	},

	"AllowedHosts": "*",

	"ReverseProxy": {
		"Routes": {
			"auth-route": {
				"ClusterId": "auth-cluster",
				"Match": {
					"Path": "api/auth/{**catch-all}"
				}
			},
			"product-route": {
				"ClusterId": "product-cluster",
				"Match": {
					"Path": "api/Product/{**catch-all}"
				}
			},
			"category-route": {
				"ClusterId": "category-cluster",
				"Match": {
					"Path": "categories/{**catch-all}"
				}
			}
		},

		"Clusters": {
			"auth-cluster": {
				"Destinations": {
					"auth-api": {
						"Address": "https://localhost:5001/"
					}
				}
			},
			"product-cluster": {
				"Destinations": {
					"product-api": {
						"Address": "https://localhost:5002/"
					}
				}
			},
			"category-cluster": {
				"Destinations": {
					"category-api": {
						"Address": "https://localhost:5003/"
					}
				}
			}
		}
	}
}
