@page "/Account/Login"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using AuthApi.Models.DTO
@using ECommerce.Models

@inject IHttpClientFactory HttpFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TokenService TokenService

<EditForm Model="login" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row justify-content-center mt-5">
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-body">

                    <h4 class="text-center mb-3">Login</h4>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger text-center">
                            @errorMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="login.Email" />
                        <ValidationMessage For="@(() => login.Email)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <InputText type="password" class="form-control" @bind-Value="login.Password" />
                        <ValidationMessage For="@(() => login.Password)" />
                    </div>

                    <button class="btn btn-primary w-100" type="submit">
                        Login
                    </button>

                    <div class="text-center mt-3">
                        <NavLink href="/Account/Register">Create an account</NavLink>
                    </div>

                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    private LoginDto login = new();
    private string? errorMessage;

    private async Task HandleLogin()
    {
        errorMessage = null;

        try
        {
            var http = HttpFactory.CreateClient("AuthApi");

            var response = await http.PostAsJsonAsync("Auth/Login", login);

            var apiResponse =
                await response.Content.ReadFromJsonAsync<ApiResponse<LoginResponseDto>>();

            if (apiResponse == null)
            {
                errorMessage = "Unexpected server response.";
                return;
            }

            if (!apiResponse.Success || apiResponse.Data == null)
            {
                errorMessage =
                    apiResponse.Error ??
                    apiResponse.Message ??
                    "Login failed.";

                return;
            }

            // ✅ Save tokens to browser storage (JS allowed here)
            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                "accessToken",
                apiResponse.Data.AccessToken);

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                "refreshToken",
                apiResponse.Data.RefreshToken);

            // ✅ Update in-memory token for HttpClient
            TokenService.SetToken(apiResponse.Data.AccessToken);

            // ✅ Navigate
            Navigation.NavigateTo("/Public/Product", forceLoad: false);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
