@page "/Public/Product"
@using ECommerce.Models
@using ProductApi.Models.DTO
@inject IHttpClientFactory HttpClientFactory

@if (products == null)
{
    <div class="text-secondary text-center mt-5">Loading...</div>
}
else if (!products.Any())
{
    <div class="text-secondary text-center mt-5">No products available.</div>
}
else
{
    <div class="container-fluid px-3">
        <div class="row g-4">
            @foreach (var product in products)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
                    <div class="card h-100 shadow-sm product-card p-2">

                        <!-- Product Image -->
                        <img src="@product.ImageUrl"
                             class="card-img-top rounded"
                             style="height:180px; object-fit:cover;" />

                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title">@product.Name</h6>
                            <p class="text-muted small mb-3">
                                @product.Description
                            </p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-success fs-6">
                                    @product.Price.ToString("C")
                                </span>

                                <button class="btn btn-sm btn-primary ms-2">
                                    Add to Cart
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<ProductDto>? products;

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("ProductApi");

        try
        {
            var response = await client
                .GetFromJsonAsync<ApiResponse<List<ProductDto>>>("Product/GetAll");

            products = response?.Data ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading products: {ex.Message}");
            products = [];
        }
    }

    private void AddToCart(ProductDto product)
    {
        Console.WriteLine($"Added {product.Name} to cart");
    }
}
